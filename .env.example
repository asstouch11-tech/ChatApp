# Chat App Environment Variables
# Copy this file to .env and fill in your values (or run run_server.py to auto-generate)

# Encryption key for message encryption (AUTO-GENERATED on first run)
# Run: python run_server.py  -- generates key and saves to .encryption_key
ENCRYPTION_KEY=

# Admin password hash (optional, for admin endpoints)
# Generate with: python -c "import secrets, hashlib; salt = secrets.token_hex(16); pwd = 'your-password'; kdf = hashlib.pbkdf2_hmac('sha256', pwd.encode(), bytes.fromhex(salt), 100000); print(f'ADMIN_PASSWORD_HASH={kdf.hex()}\nADMIN_PASSWORD_SALT={salt}')"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# Server port (Render sets this automatically)
PORT=8000

# Message TTL in hours (default: 1)
MESSAGE_TTL_HOURS=1

# Max messages per room (default: 1000)
MAX_MESSAGES_PER_ROOM=1000

# Cleanup interval in seconds (default: 300)
CLEANUP_INTERVAL_SECONDS=300